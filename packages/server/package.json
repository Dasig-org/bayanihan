{
  "name": "@bayanihan/server",
  "version": "0.1.0",
  "description": "Bayanihan Server: the reference BIX server. Stores BIX records, answers the standard BIX API, and runs Bayanihan Core on every change.",
  "type": "module",
  "main": "dist/index.js",
  "license": "AGPL-3.0-only",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/main.ts",
    "start": "tsx src/main.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/client-sesv2": "^3.1167.0",
    "@bayanihan/core": "^0.1.0",
    "@hono/node-server": "^1.13.0",
    "@noble/hashes": "^1.8.0",
    "hono": "^4.6.0",
    "jose": "^6.2.13",
    "postgres": "^3.4.4",
    "tsx": "^4.19.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4",
    "whatwg-fetch": "^3.6.20"
  },
  "author": "Dasig Inc. <hello@dasig.org>",
  "homepage": "https://github.com/Dasig-org/bayanihan#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dasig-org/bayanihan.git",
    "directory": "packages/server"
  },
  "bugs": "https://github.com/Dasig-org/bayanihan/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "data"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.13"
  }
}
