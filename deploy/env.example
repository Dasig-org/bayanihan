# Copy to .env on the server. Never commit .env.
DOMAIN=ecosystem.dasig.org
BIX_PUBLIC_URL=https://ecosystem.dasig.org
BIX_OPEN_JOIN=1
BIX_JOIN_PER_HOUR=10
BIX_CORS_ORIGINS=https://bayanihan.dasig.org
# Litestream backup to S3 (IAM user bayanihan-backup: read/write under dasig-bayanihan/db/ only)
LITESTREAM_REPLICA_URL=s3://dasig-bayanihan/db
LITESTREAM_REGION=ap-southeast-1
LITESTREAM_ENDPOINT=
LITESTREAM_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
